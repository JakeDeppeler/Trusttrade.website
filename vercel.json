{
  "buildCommand": "node scripts/gen-tradie-pages.mjs && vite build",
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/tradie/:slug", "destination": "/tradie/_dynamic.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
